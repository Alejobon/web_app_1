APP_NAME=Desahogate API
APP_ENV=development
MONGODB_CLUSTER_URI=your_cluster_uri
MONGODB_DATABASE=desahogateu
MONGODB_TIMEOUT_MS=5000

# ── Frontend / CORS ──────────────────────────────────────────────────
# Comma-separated origins allowed to call this API from a browser.
# Add your deployed frontend URL here, e.g. https://desahogate.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# ── Redis Cache (optional) ───────────────────────────────────────────
# Redis accelerates repeated reads via cache-aside. MongoDB remains
# the source of truth. Set REDIS_ENABLED=true only when a Redis server
# is available. The app starts and works normally without it.
REDIS_ENABLED=false
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
REDIS_TTL_SECONDS=300
REDIS_MESSAGE_HISTORY_TTL_SECONDS=60
REDIS_LATEST_MESSAGE_TTL_SECONDS=60

# ── Supabase Auth ───────────────────────────────────────────────────
# Frontend sends: Authorization: Bearer <supabase_access_token>
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co
# Required for legacy HS256 projects. Leave empty if using asymmetric JWKS.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_JWT_AUDIENCE=authenticated
# Optional override. Defaults to: <SUPABASE_PROJECT_URL>/auth/v1
SUPABASE_JWT_ISSUER=
# Optional override. Defaults to: <SUPABASE_PROJECT_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# ── LLM / Groq ──────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_HISTORY_LIMIT=20
LLM_RATE_LIMIT_PER_MINUTE=60
LLM_MAX_CONCURRENT_REQUESTS=5
# LLM_SYSTEM_PROMPT=Custom system prompt here (optional)
